@startuml
skinparam style strictuml

title Redstone Studio\nDiagramma delle Classi

skinparam backgroundColor #111111
skinparam classBackgroundColor #1E1E1E
skinparam classBorderColor #555555
skinparam classHeaderBackgroundColor #2A2A2A
skinparam classFontColor #DDDDDD
skinparam classAttributeFontColor #AAAAAA
skinparam packageBackgroundColor #1A1A1A
skinparam packageBorderColor #333333
skinparam interfaceBackgroundColor #1A3A1A
skinparam interfaceBorderColor #336633
skinparam arrowColor #888888
skinparam stereotypeCBackgroundColor #CC3300

' ── Interfacce ──────────────────────────────────────────────────────────

package "Domain.Interfaces" {

    interface IPowerable {
        + CurrentPower : SignalStrength
        + UpdatePower(s : SignalStrength) : void
    }

    interface IConnectable {
        + CanConnectTo(d : Direction) : bool
    }

    interface ITickable {
        + Tick() : void
    }
}

' ── Value Objects ────────────────────────────────────────────────────────

package "Domain.ValueObjects" {

    class Position {
        + X : int
        + Y : int
        + Move(d : Direction) : Position
        + Equals(obj : object) : bool
        + GetHashCode() : int
    }

    class SignalStrength {
        + Value : int
        + {static} Min : SignalStrength
        + {static} Max : SignalStrength
        + SignalStrength(value : int)
    }
}

' ── Entità ───────────────────────────────────────────────────────────────

package "Domain.Entities" {

    abstract class Entity {
        + Position : Position
        + IsPowered() : bool
        + IsPowering() : bool
        + ChangeState() : void
    }

    class Air {
    }

    class Block {
    }

    class Lever {
        - _on : bool
        + IsOn : bool
        + IsPowering() : bool
        + ChangeState() : void
    }

    class Button {
        - _ticksLeft : int
        - _pulseDuration : int
        + IsPowering() : bool
        + ChangeState() : void
        + Tick() : void
    }

    class RedstoneBlock {
        + IsPowering() : bool
    }

    class Wire {
        + CurrentPower : SignalStrength
        + UpdatePower(s : SignalStrength) : void
        + CanConnectTo(d : Direction) : bool
    }

    class Torch {
        + CurrentPower : SignalStrength
        - _on : bool
        - _placement : Direction
        - _vertical : bool
        + IsOn : bool
        + Placement : Direction
        + IsPowering() : bool
        + UpdatePower(s : SignalStrength) : void
        + CanConnectTo(d : Direction) : bool
    }

    class Repeater {
        + CurrentPower : SignalStrength
        - _output : Direction
        - _delay : int
        + Output : Direction
        + Delay : int
        + IsPowering() : bool
        + ChangeState() : void
        + UpdatePower(s : SignalStrength) : void
        + CanConnectTo(d : Direction) : bool
    }

    class RedstoneLamp {
        + CurrentPower : SignalStrength
        + IsPowered() : bool
        + UpdatePower(s : SignalStrength) : void
    }
}

' ── Application ──────────────────────────────────────────────────────────

package "Application" {

    class CircuitBoard {
        - _circuitBoard : Entity[,]
        + Width : int
        + Height : int
        + GetEntity(p : Position) : Entity
        + PlaceEntity(e : Entity, p : Position) : void
        + RemoveEntity(p : Position) : void
        + IsInBounds(p : Position) : bool
        + AllPositions() : IEnumerable<Position>
    }

    class TickSimulator {
        - _board : CircuitBoard
        + TickCount : int
        + Tick() : void
        + Reset() : void
        - BfsFlood(seeds : Queue) : void
        - ResolveTorches() : void
        - ResolveRepeaters() : void
        - ResolveLamps() : void
    }
}

' ── Infrastructure ───────────────────────────────────────────────────────

package "Infrastructure" {

    class CircuitData {
        + Width : int
        + Height : int
        + Cells : List<CellData>
    }

    class CellData {
        + X : int
        + Y : int
        + Type : string
        + Direction : string?
        + IsOn : bool?
        + Delay : int?
    }

    class JsonCircuitRepository <<static>> {
        + {static} SaveAsync(b : CircuitBoard, path : string) : Task
        + {static} LoadAsync(path : string) : Task<CircuitBoard>
    }
}

' ── UI ───────────────────────────────────────────────────────────────────

package "UI.ViewModels" {

    abstract class ViewModelBase {
    }

    class CellViewModel {
        + X : int
        + Y : int
        + BlockType : BlockType
        + IsOn : bool
        + PowerLevel : int
        + Symbol : string
        + CellColor : string
        + ForeColor : string
        + ClickCommand : IRelayCommand
        + Refresh() : void
    }

    class MainWindowViewModel {
        + Cells : ObservableCollection<CellViewModel>
        + SelectedBlockType : BlockType
        + SelectedDirection : Direction
        + IsRunning : bool
        + TickCount : int
        + PlayCommand : IRelayCommand
        + PauseCommand : IRelayCommand
        + StepCommand : IRelayCommand
        + ResetCommand : IRelayCommand
        + SaveCircuit(path : string) : Task
        + LoadCircuit(path : string) : Task
    }
}

' ── Relazioni ────────────────────────────────────────────────────────────

Entity <|-- Air
Entity <|-- Block
Entity <|-- Wire
Entity <|-- Lever
Entity <|-- Button
Entity <|-- RedstoneBlock
Entity <|-- Torch
Entity <|-- Repeater
Entity <|-- RedstoneLamp

Wire ..|> IPowerable
Wire ..|> IConnectable
Torch ..|> IPowerable
Torch ..|> IConnectable
Repeater ..|> IPowerable
Repeater ..|> IConnectable
RedstoneLamp ..|> IPowerable
Button ..|> ITickable

ViewModelBase <|-- CellViewModel
ViewModelBase <|-- MainWindowViewModel

CircuitBoard "1" *-- "many" Entity : contiene
TickSimulator --> CircuitBoard : usa
TickSimulator --> IPowerable : aggiorna
TickSimulator --> ITickable : chiama

JsonCircuitRepository --> CircuitBoard : crea
CircuitData "1" *-- "many" CellData

MainWindowViewModel --> CircuitBoard
MainWindowViewModel --> TickSimulator
MainWindowViewModel "1" *-- "many" CellViewModel

Entity --> Position
Wire --> SignalStrength
Torch --> SignalStrength
Repeater --> SignalStrength
RedstoneLamp --> SignalStrength

@enduml
