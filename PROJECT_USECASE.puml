@startuml
skinparam style strictuml

title Redstone Studio\nDiagramma dei Casi d'Uso

left to right direction

skinparam backgroundColor #1A1A1A
skinparam actorStyle awesome
skinparam actorBackgroundColor #333333
skinparam actorFontColor #DDDDDD
skinparam usecaseBackgroundColor #2A2A2A
skinparam usecaseBorderColor #CC3300
skinparam usecaseFontColor #DDDDDD
skinparam packageBackgroundColor #111111
skinparam packageBorderColor #444444
skinparam arrowColor #AAAAAA
skinparam noteFontColor #AAAAAA
skinparam noteBorderColor #555555

actor Utente as U

rectangle "Redstone Studio" {

    package "Editor" {
        usecase "Seleziona Strumento"    as UC1
        usecase "Posiziona Componente"   as UC2
        usecase "Rimuovi Componente"     as UC3
        usecase "Cambia Stato"           as UC4
        usecase "Imposta Direzione"      as UC5
    }

    package "Simulazione" {
        usecase "Avvia simulazione"      as UC6
        usecase "Pausa"                  as UC7
        usecase "Step singolo"           as UC8
        usecase "Reset griglia"          as UC9
    }

    package "File" {
        usecase "Salva circuito (JSON)"  as UC10
        usecase "Carica circuito (JSON)" as UC11
    }
}

U --> UC1
U --> UC2
U --> UC3
U --> UC4
U --> UC5
U --> UC6
U --> UC7
U --> UC8
U --> UC9
U --> UC10
U --> UC11

UC2 ..> UC1 : <<include>>
UC3 ..> UC1 : <<include>>
UC4 ..> UC2 : <<extend>>
UC7 ..> UC6 : <<extend>>

note right of UC4
  ChangeState():
  Lever  → on/off
  Button → impulso
  Repeater → cicla delay 1-4
end note

@enduml
