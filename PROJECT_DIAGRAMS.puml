' =====================================================================
' SECTION 1 — USE CASE DIAGRAM
' =====================================================================

@startuml UseCase_RedstoneStudio
title Redstone Studio — Use Case Diagram

skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecaseFontSize 12
skinparam backgroundColor #1A1A1A
skinparam actorBackgroundColor #333333
skinparam actorFontColor #DDDDDD
skinparam usecaseBackgroundColor #2A2A2A
skinparam usecaseBorderColor #CC3300
skinparam usecaseFontColor #DDDDDD
skinparam arrowColor #888888
skinparam noteFontColor #AAAAAA
skinparam noteBorderColor #555555

actor "User" as U

rectangle "Redstone Studio Application" {

    package "Board Editing" {
        usecase "Select Tool"              as UC1
        usecase "Place Component"          as UC2
        usecase "Remove Component"         as UC3
        usecase "Toggle / Cycle State"     as UC4
        usecase "Set Direction (N/E/S/W)"  as UC5
    }

    package "Simulation Control" {
        usecase "Play (auto-tick)"         as UC6
        usecase "Pause"                    as UC7
        usecase "Step (single tick)"       as UC8
        usecase "Reset Board"              as UC9
    }

    package "File Management" {
        usecase "Save Circuit to JSON"     as UC10
        usecase "Load Circuit from JSON"   as UC11
    }
}

' --- associations ---
U --> UC1
U --> UC2
U --> UC3
U --> UC4
U --> UC5
U --> UC6
U --> UC7
U --> UC8
U --> UC9
U --> UC10
U --> UC11

' --- relationships ---
UC2 ..> UC1 : <<include>>
UC3 ..> UC1 : <<include>>
UC4 ..> UC2 : <<extend>>\n(same tool, same cell)
UC7 ..> UC6 : <<extend>>

note right of UC4
  ChangeState():
  • Lever  → toggle on/off
  • Button → trigger pulse
  • Repeater → cycle delay 1–4
end note

note right of UC5
  Direction applies to
  Torch and Repeater
  on next placement.
end note

@enduml


' =====================================================================
' SECTION 2 — CLASS DIAGRAM
' =====================================================================

@startuml Class_RedstoneStudio
title Redstone Studio — Class Diagram

skinparam classBackgroundColor #1E1E1E
skinparam classBorderColor #555555
skinparam classHeaderBackgroundColor #2A2A2A
skinparam classFontColor #DDDDDD
skinparam classAttributeFontColor #AAAAAA
skinparam arrowColor #888888
skinparam backgroundColor #111111
skinparam packageBackgroundColor #1A1A1A
skinparam packageBorderColor #333333
skinparam stereotypeCBackgroundColor #CC3300
skinparam interfaceBackgroundColor #1A3A1A
skinparam interfaceBorderColor #336633

' ─────────────────────────────────────────────────────────────────────
' DOMAIN — Interfaces
' ─────────────────────────────────────────────────────────────────────

package "redstone_stone.Domain.Interfaces" {

    interface IPowerable {
        + CurrentPower : SignalStrength
        + UpdatePower(incomingPower : SignalStrength) : void
    }

    interface IConnectable {
        + CanConnectTo(direction : Direction) : bool
    }

    interface ITickable {
        + Tick() : void
    }
}

' ─────────────────────────────────────────────────────────────────────
' DOMAIN — Value Objects
' ─────────────────────────────────────────────────────────────────────

package "redstone_stone.Domain.ValueObjects" {

    class Position {
        + X : int
        + Y : int
        + Position(x : int, y : int)
        + Move(direction : Direction) : Position
        + Equals(obj : object) : bool
        + GetHashCode() : int
    }

    class SignalStrength {
        + Value : int
        + {static} Min : SignalStrength
        + {static} Max : SignalStrength
        + SignalStrength(value : int)
    }
}

' ─────────────────────────────────────────────────────────────────────
' DOMAIN — Enums
' ─────────────────────────────────────────────────────────────────────

package "redstone_stone.Domain.Enums" {

    enum Direction {
        North
        East
        South
        West
    }

    enum BlockType {
        Air
        Block
        Wire
        Lever
        Button
        RedstoneBlock
        Torch
        Repeater
        RedstoneLamp
    }
}

' ─────────────────────────────────────────────────────────────────────
' DOMAIN — Entities
' ─────────────────────────────────────────────────────────────────────

package "redstone_stone.Domain.Entities" {

    abstract class Entity {
        + Position : Position
        + IsPowered() : bool
        + IsPowering() : bool
        + ChangeState() : void
    }

    class Air {
    }

    class Block {
    }

    class Wire {
        + CurrentPower : SignalStrength
        + CanConnectTo(direction : Direction) : bool
        + UpdatePower(incomingPower : SignalStrength) : void
    }

    class Lever {
        - _on : bool
        + IsOn : bool
        + IsPowering() : bool
        + ChangeState() : void
    }

    class Button {
        - _ticksLeft : int
        - _pulseDuration : int
        + IsPowering() : bool
        + ChangeState() : void
        + Tick() : void
    }

    class RedstoneBlock {
        + IsPowering() : bool
    }

    class Torch {
        + CurrentPower : SignalStrength
        - _on : bool
        - _placement : Direction
        - _vertical : bool
        + IsOn : bool
        + Placement : Direction
        + IsVertical : bool
        + IsPowering() : bool
        + CanConnectTo(direction : Direction) : bool
        + UpdatePower(incomingPower : SignalStrength) : void
    }

    class Repeater {
        + CurrentPower : SignalStrength
        - _output : Direction
        - _delay : int
        - _on : bool
        + Output : Direction
        + Delay : int
        + IsPowering() : bool
        + ChangeState() : void
        + CanConnectTo(direction : Direction) : bool
        + UpdatePower(incomingPower : SignalStrength) : void
    }

    class RedstoneLamp {
        + CurrentPower : SignalStrength
        + IsPowered() : bool
        + UpdatePower(incomingPower : SignalStrength) : void
    }
}

' ─────────────────────────────────────────────────────────────────────
' APPLICATION
' ─────────────────────────────────────────────────────────────────────

package "redstone_stone.Application" {

    class CircuitBoard {
        - _circuitBoard : Entity[,]
        + Width : int
        + Height : int
        + CircuitBoard(width : int, height : int)
        + GetEntity(position : Position) : Entity
        + PlaceEntity(entity : Entity, position : Position) : void
        + RemoveEntity(position : Position) : void
        + IsInBounds(position : Position) : bool
        + AllPositions() : IEnumerable<Position>
    }

    class TickSimulator {
        - _board : CircuitBoard
        - _pendingRepeaters : Queue
        + TickCount : int
        + Tick() : void
        + Reset() : void
        - AdvanceTickables() : void
        - ResetAllPower() : void
        - CollectSources() : Queue
        - BfsFlood(seeds : Queue) : void
        - ResolveTorches() : bool
        - ResolveRepeaters() : void
        - MaxNeighborPower(pos : Position) : int
    }
}

' ─────────────────────────────────────────────────────────────────────
' INFRASTRUCTURE
' ─────────────────────────────────────────────────────────────────────

package "redstone_stone.Infrastructure.Persistance" {

    class CircuitData {
        + Width : int
        + Height : int
        + Cells : List<CellData>
    }

    class CellData {
        + X : int
        + Y : int
        + Type : string
        + Direction : string?
        + IsOn : bool?
        + Delay : int?
        + Vertical : bool?
    }

    class JsonCircuitRepository <<static>> {
        + {static} SaveAsync(board : CircuitBoard, path : string) : Task
        + {static} LoadAsync(path : string) : Task<CircuitBoard>
        - {static} ToCellData(entity : Entity, pos : Position) : CellData?
        - {static} ToEntity(cell : CellData) : Entity?
    }
}

' ─────────────────────────────────────────────────────────────────────
' UI (MVVM)
' ─────────────────────────────────────────────────────────────────────

package "redstone_stone.ViewModels" {

    abstract class ViewModelBase {
    }

    class CellViewModel {
        + X : int
        + Y : int
        + BlockType : BlockType
        + Direction : Direction
        + IsOn : bool
        + PowerLevel : int
        + Symbol : string
        + CellColor : string
        + ForeColor : string
        + ClickCommand : IRelayCommand
        + Refresh() : void
    }

    class MainWindowViewModel {
        + GridWidth : int
        + GridHeight : int
        + Cells : ObservableCollection<CellViewModel>
        + SelectedBlockType : BlockType
        + SelectedDirection : Direction
        + IsRunning : bool
        + TickCount : int
        + StatusText : string
        + PlayCommand : IRelayCommand
        + PauseCommand : IRelayCommand
        + StepCommand : IRelayCommand
        + ResetCommand : IRelayCommand
        + SelectToolCommand : IRelayCommand
        + RotateDirectionCommand : IRelayCommand
        + SaveCircuit(path : string) : Task
        + LoadCircuit(path : string) : Task
    }
}

' ─────────────────────────────────────────────────────────────────────
' RELATIONSHIPS
' ─────────────────────────────────────────────────────────────────────

' Inheritance — entities
Entity <|-- Air
Entity <|-- Block
Entity <|-- Wire
Entity <|-- Lever
Entity <|-- Button
Entity <|-- RedstoneBlock
Entity <|-- Torch
Entity <|-- Repeater
Entity <|-- RedstoneLamp

' Interface implementations
Wire        ..|> IPowerable
Wire        ..|> IConnectable
Torch       ..|> IPowerable
Torch       ..|> IConnectable
Repeater    ..|> IPowerable
Repeater    ..|> IConnectable
RedstoneLamp ..|> IPowerable
Button      ..|> ITickable

' ViewModels
ViewModelBase <|-- CellViewModel
ViewModelBase <|-- MainWindowViewModel

' Application → Domain
CircuitBoard   --> Entity         : stores
TickSimulator  --> CircuitBoard   : reads/writes
TickSimulator  --> IPowerable     : uses
TickSimulator  --> ITickable      : uses

' Infrastructure → Application/Domain
JsonCircuitRepository --> CircuitBoard  : creates
JsonCircuitRepository --> CircuitData   : serializes
CircuitData           o-- CellData

' UI → Application/Domain
MainWindowViewModel --> CircuitBoard
MainWindowViewModel --> TickSimulator
MainWindowViewModel o-- CellViewModel
CellViewModel       --> BlockType
CellViewModel       --> Direction

' Value Object usage
Entity --> Position
Wire   --> SignalStrength
Torch  --> SignalStrength
Repeater --> SignalStrength
RedstoneLamp --> SignalStrength

@enduml
